#include "resources/assets.h"
#include <array>

namespace corncob::resources {

namespace {

std::array<uint8_t, @resource_size@> const @resource_name@_bytes{
  @resource_bytes@
};

} // anonymous namespace

std::span<uint8_t const> @resource_name@_asset() noexcept {
  /// Expose immutable resource bytes embedded at build time
  return @resource_name@_bytes;
}

} // namespace corncob::resources
